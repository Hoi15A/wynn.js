{
  "name": "wynn.js",
  "version": "0.1.0",
  "description": "Simple Wynncraft API wrapper",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "test": "tsx tests/errorHandling.test.ts",
    "test-players": "tsx tests/players.test.ts",
    "test-playersearch": "tsx tests/playerSearch.test.ts",
    "test-guilds": "tsx tests/guilds.test.ts",
    "test-items": "tsx tests/items.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoi15A/wynn.js.git"
  },
  "author": "Austin Albrecht",
  "contributors": [
    "Sebiann <code@sebiann.moe>"
  ],
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
